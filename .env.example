# ============================================================
# LLM Configuration
# ============================================================

# Required
GROQ_API_KEY=

# Groq model used by the LLM agent
GROQ_MODEL=openai/gpt-oss-120b

# Agent mode:
# llm      = LLM-powered agent
# fallback = deterministic keyword-based agent
AGENT_MODE=llm

# LLM request timeout in seconds
LLM_TIMEOUT=30

# MCP tool execution timeout in seconds
MCP_TIMEOUT=30

# ============================================================
# Application Configuration
# ============================================================

API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501